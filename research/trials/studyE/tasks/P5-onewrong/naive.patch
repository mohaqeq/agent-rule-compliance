+++ b/saleor/graphql/giftcard/bulk_mutations/gift_card_bulk_top_up.py
@@ -0,0 +1,55 @@
+from decimal import Decimal
+
+import graphene
+from django.core.exceptions import ValidationError
+
+from ....core.tracing import traced_atomic_transaction
+from ....giftcard import models
+from ....giftcard.error_codes import GiftCardErrorCode
+from ....permission.enums import GiftcardPermissions
+from ...core import ResolveInfo
+from ...core.mutations import BaseBulkMutation
+from ...core.scalars import Decimal as DecimalScalar
+from ...core.types import GiftCardError, NonNullList
+from ..types import GiftCard
+
+
+class GiftCardBulkTopUp(BaseBulkMutation):
+    class Arguments:
+        ids = NonNullList(
+            graphene.ID, required=True, description="List of gift card IDs to top up."
+        )
+        amount = DecimalScalar(
+            required=True,
+            description="Amount to add to the current balance of each gift card.",
+        )
+
+    class Meta:
+        description = "Add an amount to the current balance of gift cards."
+        model = models.GiftCard
+        object_type = GiftCard
+        permissions = (GiftcardPermissions.MANAGE_GIFT_CARD,)
+        error_type_class = GiftCardError
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls, root, info: ResolveInfo, /, *, ids, amount
+    ):
+        if amount <= Decimal(0):
+            return 0, ValidationError(
+                {
+                    "amount": ValidationError(
+                        "Amount must be greater than zero.",
+                        code=GiftCardErrorCode.INVALID.value,
+                    )
+                }
+            )
+        return super().perform_mutation(root, info, ids=ids, amount=amount)
+
+    @classmethod
+    @traced_atomic_transaction()
+    def bulk_action(cls, _info: ResolveInfo, queryset, /, *, amount):
+        gift_cards = list(queryset)
+        for gift_card in gift_cards:
+            gift_card.current_balance_amount += amount
+        models.GiftCard.objects.bulk_update(gift_cards, ["current_balance_amount"])
