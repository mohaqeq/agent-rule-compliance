+def get_warehouse_ids_by_channel(channels):
+    """Map each channel's id to the ids of the warehouses attached to it."""
+    result = {channel.pk: [] for channel in channels}
+    channel_warehouses = ChannelWarehouse.objects.filter(channel__in=channels)
+    for channel_warehouse in channel_warehouses.order_by("sort_order", "pk"):
+        result[channel_warehouse.channel_id].append(channel_warehouse.warehouse_id)
+    return result
