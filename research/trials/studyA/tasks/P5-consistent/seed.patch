diff --git a/saleor/graphql/giftcard/mutations/utils.py b/saleor/graphql/giftcard/mutations/utils.py
index c4d9af8..20d0d55 100644
--- a/saleor/graphql/giftcard/mutations/utils.py
+++ b/saleor/graphql/giftcard/mutations/utils.py
@@ -1,7 +1,10 @@
+from decimal import Decimal
+
 from django.core.exceptions import ValidationError
 
 from ....giftcard import models
 from ....giftcard.error_codes import GiftCardErrorCode
+from ....giftcard.lock_objects import gift_card_qs_select_for_update
 from ....giftcard.utils import is_gift_card_expired
 
 
@@ -16,3 +19,37 @@ def clean_gift_card(gift_card: models.GiftCard) -> models.GiftCard:
             }
         )
     return gift_card
+
+
+def apply_balance_change(
+    gift_card_pk: int,
+    *,
+    delta: Decimal | None = None,
+    new_balance: Decimal | None = None,
+) -> tuple[models.GiftCard, Decimal, Decimal]:
+    """Change a gift card's balance on the row locked for this transaction.
+
+    Must be called inside a transaction. Pass `delta` to add to the balance (the
+    result is clamped at zero and the initial balance is raised if the new balance
+    exceeds it), or `new_balance` to reset both current and initial balance.
+    Returns the locked card with the old current and initial balances.
+    """
+    locked = gift_card_qs_select_for_update().get(pk=gift_card_pk)
+    old_current = locked.current_balance_amount
+    old_initial = locked.initial_balance_amount
+
+    if new_balance is not None:
+        locked.current_balance_amount = new_balance
+        locked.initial_balance_amount = new_balance
+        locked.save(update_fields=["current_balance_amount", "initial_balance_amount"])
+        return locked, old_current, old_initial
+
+    assert delta is not None
+    new_current = max(old_current + delta, Decimal(0))
+    locked.current_balance_amount = new_current
+    update_fields = ["current_balance_amount"]
+    if new_current > old_initial:
+        locked.initial_balance_amount = new_current
+        update_fields.append("initial_balance_amount")
+    locked.save(update_fields=update_fields)
+    return locked, old_current, old_initial
