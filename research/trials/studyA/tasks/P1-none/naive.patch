+ERASURE_GRACE_PERIOD = timedelta(days=30)
+
+
+@app.task()
+@allow_writer()
+def delete_requested_customers_task() -> int:
+    """Delete customers who asked for erasure at least 30 days ago."""
+    threshold = timezone.now() - ERASURE_GRACE_PERIOD
+    instances = list(
+        User.objects.filter(is_staff=False, delete_requested_at__lte=threshold)
+    )
+    if not instances:
+        return 0
+    queryset = User.objects.filter(pk__in=[user.pk for user in instances])
+    with traced_atomic_transaction():
+        delete_user_unique_attribute_values(queryset.values_list("pk", flat=True))
+        queryset.delete()
+    manager = get_plugins_manager(allow_replica=False)
+    for instance in instances:
+        call_event(manager.customer_deleted, instance)
+    return len(instances)
