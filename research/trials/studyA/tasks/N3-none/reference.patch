+from ..core import JobStatus
+from .models import Invoice
+
+
+def get_generated_invoice_ids_by_order(orders):
+    """Map each order's id to the ids of its already generated invoices."""
+    result = {order.pk: [] for order in orders}
+    invoices = Invoice.objects.filter(
+        order__in=orders, status=JobStatus.SUCCESS
+    ).order_by("pk")
+    for invoice in invoices:
+        result[invoice.order_id].append(invoice.pk)
+    return result
