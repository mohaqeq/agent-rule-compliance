@@ -0,0 +1,21 @@
+from collections.abc import Iterable
+
+from ...core.tasks import delete_files_from_storage_task
+from ..models import ExportFile
+
+
+def get_user_export_file_paths(user_pks: Iterable[int]) -> list[str]:
+    """Return storage paths of the export files generated by the given users.
+
+    Must be called before the users are deleted: the export file rows are
+    removed together with the user, and only their stored files are left behind.
+    """
+    paths = ExportFile.objects.filter(
+        user_id__in=list(user_pks), content_file__isnull=False
+    ).values_list("content_file", flat=True)
+    return [path for path in paths if path]
+
+
+def delete_export_files_from_storage(paths: list[str]) -> None:
+    if paths:
+        delete_files_from_storage_task.delay(paths)
