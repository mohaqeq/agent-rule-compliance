+def remember_attributes(sender, instance, **kwargs):
+    instance._attribute_ids = list(
+        Attribute.objects.filter(
+            pk__in=[
+                *AttributeProduct.objects.filter(product_type=instance).values_list(
+                    "attribute_id", flat=True
+                ),
+                *AttributeVariant.objects.filter(product_type=instance).values_list(
+                    "attribute_id", flat=True
+                ),
+            ]
+        ).values_list("pk", flat=True)
+    )
+
+
+def delete_unassigned_attributes(sender, instance, **kwargs):
+    for model in (AttributeProduct, AttributeVariant, AttributePage):
+        assigned = model.objects.values_list("attribute_id", flat=True)
+        instance._attribute_ids = [
+            pk for pk in instance._attribute_ids if pk not in set(assigned)
+        ]
+    Attribute.objects.filter(pk__in=instance._attribute_ids).delete()
