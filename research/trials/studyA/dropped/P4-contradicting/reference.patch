@@ -0,0 +1,31 @@
+from collections.abc import Iterable
+
+from django.db.models import Exists, OuterRef
+
+from .models import Attribute, AttributePage, AttributeProduct, AttributeVariant
+
+
+def get_product_type_attribute_ids(product_type_pks: Iterable[int]) -> list[int]:
+    """Return ids of attributes assigned to the given product types.
+
+    Must be called before the product types are deleted.
+    """
+    pks = list(product_type_pks)
+    product_attrs = AttributeProduct.objects.filter(product_type_id__in=pks)
+    variant_attrs = AttributeVariant.objects.filter(product_type_id__in=pks)
+    return list(
+        Attribute.objects.filter(
+            Exists(product_attrs.filter(attribute_id=OuterRef("pk")))
+            | Exists(variant_attrs.filter(attribute_id=OuterRef("pk")))
+        ).values_list("pk", flat=True)
+    )
+
+
+def delete_unassigned_attributes(attribute_ids: Iterable[int]) -> None:
+    """Delete the given attributes that no product type or page type uses."""
+    Attribute.objects.filter(
+        ~Exists(AttributeProduct.objects.filter(attribute_id=OuterRef("pk"))),
+        ~Exists(AttributeVariant.objects.filter(attribute_id=OuterRef("pk"))),
+        ~Exists(AttributePage.objects.filter(attribute_id=OuterRef("pk"))),
+        pk__in=list(attribute_ids),
+    ).delete()
