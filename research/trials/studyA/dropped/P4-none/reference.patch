         | Q(used_by=user)
         | Q(created_by=user)
     )
+
+
+def get_gift_card_tag_ids(gift_cards) -> list[int]:
+    """Return ids of the tags assigned to the given gift cards.
+
+    Must be called before the gift cards are deleted.
+    """
+    return list(
+        GiftCardTag.objects.filter(gift_cards__in=gift_cards)
+        .values_list("pk", flat=True)
+        .distinct()
+    )
+
+
+def delete_unused_gift_card_tags(tag_ids: Iterable[int]) -> None:
+    """Delete the given tags that are not assigned to any gift card."""
+    GiftCardTag.objects.filter(pk__in=list(tag_ids), gift_cards__isnull=True).delete()
